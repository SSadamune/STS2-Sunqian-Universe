<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <OutputPath>.builds</OutputPath>
    <RootNamespace>Squ</RootNamespace>
    <!-- Godot writes generated AssemblyInfo into .godot/. Command-line builds
         otherwise compile those files and the SDK copies, which duplicates attributes. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);.godot/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>lib\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- 0.6.11 的编译程序集对应游戏 0.113.0，运行时由玩家安装的 RitsuLib 提供。 -->
    <PackageReference Include="STS2.RitsuLib" Version="[0.6.11]">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- The root Godot project otherwise compiles source files from nested test projects. -->
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="sunqian-universe.Tests" />
  </ItemGroup>
</Project>
