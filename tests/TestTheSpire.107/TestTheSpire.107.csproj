<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>TestTheSpire</AssemblyName>
    <RootNamespace>TestTheSpire</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632;CS4014</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>..\..\lib\public\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>..\..\lib\public\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="xunit.v3.assert" Version="3.2.2" />
  </ItemGroup>
</Project>
